PORT=3001
CLIENT_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Chuoi bi mat rieng de ky phien truy cap link chia se (neu bo trong se dung service role key)
SHARE_TOKEN_SECRET=replace-with-a-long-random-secret
# Neu dat, dashboard se hoi ma nay mot lan trong moi phien trinh duyet.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# Messenger mac dinh tat, nen deploy code moi khong anh huong CRM hien tai.
MESSENGER_ENABLED=false
META_VERIFY_TOKEN=replace-with-a-random-verify-token
META_APP_SECRET=replace-with-meta-app-secret
META_PAGE_ACCESS_TOKEN=replace-with-page-access-token
META_PAGE_ID=replace-with-page-id
META_PIPELINE_ID=
# Có thể dùng slug thay cho UUID để dễ cấu hình, ví dụ: gach-phuong-nam.
META_PIPELINE_SLUG=
META_GRAPH_API_VERSION=v23.0

# disabled | ollama | gemini
AI_PROVIDER=disabled

# Ollama: mien phi, chay local, khong phu hop Vercel neu Ollama chi o may ca nhan.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Gemini free tier: co han muc va du lieu free tier co the duoc dung de cai thien san pham.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
